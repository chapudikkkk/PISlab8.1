<Window x:Class="PISlab8._2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PISlab8._2"
        mc:Ignorable="d"
        Title="Аналіз ефективності курсу" Height="200" Width="300">
    <Window.Resources>
        <Style x:Key="all_style" TargetType="{x:Type Control}">
            <Setter Property="FontFamily" Value="Verdana"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Window.Resources>
    <Grid>
        <StackPanel Margin="10">
            <Label Style="{StaticResource all_style}" Padding="2">Оцінка студентів =</Label>
            <TextBox x:Name="rating" Text="{Binding Number1, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource all_style}" Height="25"/>
            <Label Style="{StaticResource all_style}" Padding="2">Час навчання (год) =</Label>
            <TextBox x:Name="hours" Text="{Binding Number2, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource all_style}" Height="25"/>
            <Label x:Name="result" Style="{StaticResource all_style}" Padding="2">Ефективність курсу</Label>
            <TextBox x:Name="effectiveness" Text="{Binding Number3, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource all_style}" Height="25"/>
        </StackPanel>
    </Grid>
</Window>